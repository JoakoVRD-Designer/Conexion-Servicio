# Copia este archivo a .env y completa los valores. Solo ADMIN_PASSWORD es obligatorio.

# ---- Servidor ----
PORT=3000
# URL pública (para los enlaces que reciben los clientes por email), ej. https://pedidos.midominio.com
PUBLIC_URL=
# Pon 1 si corres detrás de un proxy (Render, Railway, Nginx...)
TRUST_PROXY=0
# Nombre con el que firmas los emails
BUSINESS_NAME=Mi Estudio Web

# ---- Panel /admin ----
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# ---- IA (Claude). Clave en https://console.anthropic.com/ ----
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5
AI_MODEL=

# ---- Emails automáticos al cliente (opcional pero recomendado) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu@gmail.com,
#        SMTP_PASS=<contraseña de aplicación de 16 letras> (myaccount.google.com → Seguridad → Contraseñas de aplicaciones)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Recibir también por email los avisos de pedidos/mensajes nuevos
OWNER_EMAIL=

# ---- Publicación con un clic en Netlify (opcional) ----
# app.netlify.com → User settings → Applications → Personal access tokens
NETLIFY_TOKEN=

# ---- Avisos al celular (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Discord, Make, Zapier...)
NOTIFY_WEBHOOK_URL=
