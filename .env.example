# Copia este archivo a .env y completa los valores.

# Puerto del servidor
PORT=3000
# URL pública (para los enlaces que se envían a clientes), ej. https://pedidos.midominio.com
PUBLIC_URL=
# Pon 1 si corres detrás de un proxy (Render, Railway, Nginx...)
TRUST_PROXY=0

# Acceso al panel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# IA (Claude). Consigue tu clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5
AI_MODEL=

# Avisos de pedidos/mensajes nuevos (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Discord, Make, Zapier...)
NOTIFY_WEBHOOK_URL=
